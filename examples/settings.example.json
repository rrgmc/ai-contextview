{
  "env": { "MCP_TOOL_TIMEOUT": "1800000" },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(AskUserQuestion|Skill|mcp__.*ai-contextview.*__.+)$",
        "hooks": [{ "type": "command", "command": "ai-contextview hook" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "ai-contextview hook" }]
      }
    ]
  }
}
