{
  "env": { "MCP_TOOL_TIMEOUT": "1800000" },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|Skill",
        "hooks": [{ "type": "command", "command": "ai-specview hook" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "ai-specview hook" }]
      }
    ]
  }
}
